# Copy to mobile/.env for local Expo testing. Restart Expo with `npx expo start -c` after any change.

# Backend API. Leave empty while testing with Expo: the app then uses your PC's
# address on port 3000. A built APK needs this set (see eas.json / EAS environment variables).
EXPO_PUBLIC_API_URL=

# The web app, opened by "Forgot password?" on the sign-in screen.
# Use the deployed address, e.g. https://your-web-address (no trailing slash).
EXPO_PUBLIC_WEB_URL=
