PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://brickuser:brickpass@localhost:5432/brickxbrick
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=


GOOGLE_APPLICATION_CREDENTIALS=
# ============================================
# CLOUDFLARE R2 (F6 receipt storage)
# ============================================
# dash.cloudflare.com -> R2 -> Create bucket (name it brickxbrick-receipts)
# Account ID is in the R2 sidebar.
R2_ACCOUNT_ID=
# R2 -> Manage R2 API Tokens -> Create API Token
#   -> Object Read & Write -> scope to your bucket
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=brickxbrick-receipts
# Bucket -> Settings -> Public Development URL (enable it, paste here)
R2_PUBLIC_BASE_URL=