PORT=3000
DATABASE_URL=postgresql://brickuser:brickpass@localhost:5432/brickxbrick
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
GOOGLE_VISION_API_KEY=
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
# Web app address. Invite and password emails open FRONTEND_URL/set-password.
# Use the same address you open in the browser (e.g. http://127.0.0.1:5173),
# and add it to Supabase > Authentication > URL Configuration > Redirect URLs
# as http://127.0.0.1:5173/** (plus the deployed site's address/**).
FRONTEND_URL=http://127.0.0.1:5173
# Receipt OCR. Gemini is the only engine; if it fails the user types the receipt in.
GEMINI_API_KEY=
# Optional; defaults to the model in src/lib/geminiReceipt.js
GEMINI_MODEL=
# Optional; tried when GEMINI_MODEL is busy or slow ("none" to skip)
GEMINI_FALLBACK_MODEL=
# Credentials for scripts/db-tools/seed_resolved_ticket.js and seed_report_data.js. The scripts
# refuse to run until these are set; use throwaway accounts, never real ones.
SEED_ADMIN_EMAIL=CHANGE-ME-BEFORE-RUNNING
SEED_ADMIN_PASSWORD=CHANGE-ME-BEFORE-RUNNING
SEED_SM_EMAIL=CHANGE-ME-BEFORE-RUNNING
SEED_SM_PASSWORD=CHANGE-ME-BEFORE-RUNNING
SEED_PURCHASER_B_EMAIL=CHANGE-ME-BEFORE-RUNNING
SEED_PURCHASER_B_PASSWORD=CHANGE-ME-BEFORE-RUNNING
SEED_PM_SEED_EMAIL=CHANGE-ME-BEFORE-RUNNING
SEED_PM_SEED_PASSWORD=CHANGE-ME-BEFORE-RUNNING
SEED_REPORT_GM_EMAIL=CHANGE-ME-BEFORE-RUNNING
SEED_REPORT_PM_EMAIL=CHANGE-ME-BEFORE-RUNNING
